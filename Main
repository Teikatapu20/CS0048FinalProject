import os

# Inventory with standardized lowercase keys for easy matching, paired with display names and status
inventory = {
    "table saw": {"ID#": "1001","display": "Table Saw", "cost": "$29.99", "status": "Available"},
    "power drill": {"ID#": "1002","display": "Power Drill", "cost": "$39.99", "status": "Available"},
    "hand plane": {"ID#": "1003","display": "Hand Plane", "cost": "$19.99", "status": "Available"},
    "wood chisel": {"ID#": "1004","display": "Wood Chisel", "cost": "$14.99", "status": "Available"},
    "circular saw": {"ID#": "1005","display": "Circular Saw", "cost": "$49.99", "status": "Available"},
    "jigsaw": {"ID#": "1006","display": "Jigsaw", "cost": "$34.99", "status": "Available"},
    "router": {"ID#": "1007","display": "Router", "cost": "$24.99", "status": "Available"},
    "sander": {"ID#": "1008","display": "Sander", "cost": "$19.99", "status": "Available"},
    "clamps": {"ID#": "1009","display": "Clamps", "cost": "$9.99", "status": "Available"},
    "measuring tape": {"ID#": "1010","display": "Measuring Tape", "cost": "$5.99", "status": "Available"},
}



def clear_screen():
    """Clears the terminal screen for a clean look."""
    os.system("cls" if os.name == "nt" else "clear")


def show_dashboard():
    while True:
        clear_screen()
        print("=" * 35)
        print("  CARPENTRY RENTAL SYSTEM  ")
        print("=" * 35)
        print(" 1.  View Items")
        print(" 2.  Rent Item")
        print(" 3.  Return Item")
        print(" 4.  Exit System")
        print("=" * 35)

        choice = input("Select an option (1-4): ").strip()

        if choice == "1":
            clear_screen()
            print(" --- CURRENT INVENTORY ---")
            print("-" * 70)
            for key, details in inventory.items():
               print(
                    f"ID: {details['ID#']} | Item: {details['display']:<15} | Price: {details['cost']:<6} | Status: {details['status']}"
            print("-" * 70)
            input("\nPress Enter to return to dashboard...")

        elif choice == "2":
            clear_screen()
            print(" --- RENT AN ITEM ---")
            # Converts user input to lowercase automatically
            user_input = input("Enter item name to rent: ").strip().lower()

            if user_input in inventory:
                item_details = inventory[user_input]
                if item_details["status"] == "Available":
                    item_details["status"] = "Rented"
                    print(
                        f"\nSuccess! '{item_details['display']}' has been checked out."
                    )
                else:
                    print(
                        f"\n Sorry, '{item_details['display']}' is already rented!"
                    )
            else:
                print("\n Item not found in our catalog.")
            input("\nPress Enter to return to dashboard...")

        elif choice == "3":
            clear_screen()
            print(" --- RETURN AN ITEM ---")
            # Converts user input to lowercase automatically
            user_input = input("Enter item name to return: ").strip().lower()

            if user_input in inventory:
                item_details = inventory[user_input]
                if item_details["status"] == "Rented":
                    item_details["status"] = "Available"
                    print(
                        f"\nSuccess! '{item_details['display']}' is back in stock."
                    )
                else:
                    print(
                        f"\n '{item_details['display']}' was not checked out."
                    )
            else:
                print("\n Item not found in our catalog.")
            input("\nPress Enter to return to dashboard...")

        elif choice == "4":
            print("\nExiting system. Goodbye!")
            break

        else:
            input("\nInvalid choice! Press Enter to try again...")


if __name__ == "__main__":
    show_dashboard()

