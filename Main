import os
import json

FILE_NAME = "inventory.json"

# Default inventory
DEFAULT_INVENTORY = {
    "1": {"display": "Table Saw", "status": "Available", "quantity": 5, "price_per_day": 300},
    "2": {"display": "Power Drill", "status": "Available", "quantity": 4, "price_per_day": 200},
    "3": {"display": "Hand Plane", "status": "Available", "quantity": 6, "price_per_day": 150},
    "4": {"display": "Wood Chisel", "status": "Available", "quantity": 10, "price_per_day": 100},
    "5": {"display": "Circular Saw", "status": "Available", "quantity": 3, "price_per_day": 350},
    "6": {"display": "Jigsaw", "status": "Available", "quantity": 5, "price_per_day": 300},
    "7": {"display": "Router", "status": "Available", "quantity": 4, "price_per_day": 200},
    "8": {"display": "Sander", "status": "Available", "quantity": 6, "price_per_day": 150},
    "9": {"display": "Clamp", "status": "Available", "quantity": 10, "price_per_day": 100},
    "10": {"display": "Hammer", "status": "Available", "quantity": 3, "price_per_day": 350},
}

def save_inventory(inventory_data):
    with open(FILE_NAME, "w") as file:
        json.dump(inventory_data, file, indent=4)

def load_inventory():
    if os.path.exists(FILE_NAME):
        with open(FILE_NAME, "r") as file:
            return json.load(file)
    else:
        save_inventory(DEFAULT_INVENTORY)
        return DEFAULT_INVENTORY.copy()

def clear_screen():
    os.system("cls" if os.name == "nt" else "clear")

def pause():
    input("\nPress Enter to continue...")

def show_inventory(inventory_data, title):
    print(f" --- {title} ---")
    print(f"{'ID':<5}{'Tool':<20}{'Qty':<8}{'Price/Day':<12}{'Status'}")
    print("-" * 70)

    for tool_id, details in inventory_data.items():
        print(
            f"{tool_id:<5}"
            f"{details['display']:<20}"
            f"{details['quantity']:<8}"
            f"₱{details['price_per_day']:<11}"
            f"{details['status']}"
        )

    print("-" * 70)

def show_dashboard():
    inventory = load_inventory()

    while True:
        clear_screen()
        print("=" * 50)
        print("      CARPENTRY POWER TOOL RENTAL SYSTEM")
        print("=" * 50)
        print("        Inventory and Rental Management")
        print("=" * 50)
        print(" 1.  View Items")
        print(" 2.  Rent Item")
        print(" 3.  Return Item")
        print(" 4.  Exit System")
        print("=" * 50)

        choice = input("Select an option (1-4): ").strip()

        if choice == "1":
            clear_screen()
            inventory = load_inventory()
            show_inventory(inventory, "CURRENT INVENTORY")
            pause()

        elif choice == "2":
            clear_screen()
            inventory = load_inventory()

            print(" --- RENT AN ITEM ---")
            print("Available Tools:")
            print("-" * 100)

            for tool_id, details in inventory.items():
                print(
                    f"ID: {tool_id:<2} | {details['display']:<15} | "
                    f"Qty: {details['quantity']:<3} | "
                    f"₱{details['price_per_day']}/day | "
                    f"Status: {details['status']}"
                )

            print("-" * 100)

            selected_id = input("Enter the Tool ID you want to rent: ").strip()

            if selected_id not in inventory:
                print("\nTool ID not found in the inventory.")
                pause()
                continue

            item_details = inventory[selected_id]

            if item_details["quantity"] <= 0:
                print(f"\nSorry, '{item_details['display']}' is out of stock.")
                pause()
                continue

            try:
                rent_qty = int(input("Enter quantity to rent: "))
                rental_days = int(input("Enter number of rental days: "))
            except ValueError:
                print("\nInvalid input. Please enter numbers only.")
                pause()
                continue

            if rent_qty <= 0 or rental_days <= 0:
                print("\nQuantity and rental days must be greater than zero.")
                pause()
                continue

            if rent_qty > item_details["quantity"]:
                print(
                    f"\nSorry, only {item_details['quantity']} item(s) of "
                    f"'{item_details['display']}' are available."
                )
                pause()
                continue

            total = rent_qty * rental_days * item_details["price_per_day"]
            item_details["quantity"] -= rent_qty

            if item_details["quantity"] == 0:
                item_details["status"] = "Not Available"
            else:
                item_details["status"] = "Available"

            save_inventory(inventory)

            clear_screen()
            print("\nRental Successful!")
            print(f"Tool: {item_details['display']}")
            print(f"Quantity Rented: {rent_qty}")
            print(f"Rental Days: {rental_days}")
            print(f"Price per Day: ₱{item_details['price_per_day']}")
            print(f"Total Amount: ₱{total}")
            print(f"Remaining Quantity: {item_details['quantity']}")
            print(f"Status: {item_details['status']}")
            pause()

        elif choice == "3":
            clear_screen()
            inventory = load_inventory()

            print(" --- RETURN AN ITEM ---")
            print("Current Tools:")
            print("-" * 100)

            for tool_id, details in inventory.items():
                print(
                    f"ID: {tool_id:<2} | {details['display']:<15} | "
                    f"Qty: {details['quantity']:<3} | "
                    f"₱{details['price_per_day']}/day | "
                    f"Status: {details['status']}"
                )

            print("-" * 100)

            selected_id = input("Enter the Tool ID you want to return: ").strip()

            if selected_id not in inventory:
                print("\nTool ID not found in the inventory.")
                pause()
                continue

            item_details = inventory[selected_id]

            try:
                return_qty = int(input("Enter quantity to return: "))
            except ValueError:
                print("\nInvalid input. Please enter a number only.")
                pause()
                continue

            if return_qty <= 0:
                print("\nQuantity must be greater than zero.")
                pause()
                continue

            item_details["quantity"] += return_qty
            item_details["status"] = "Available"

            save_inventory(inventory)

            print(f"\nSuccess! '{item_details['display']}' has been returned.")
            print(f"Updated Quantity: {item_details['quantity']}")
            print(f"Status: {item_details['status']}")
            pause()

        elif choice == "4":
            print("\nExiting system. Goodbye!")
            break

        else:
            print("\nInvalid choice!")
            pause()

if __name__ == "__main__":
    show_dashboard()
